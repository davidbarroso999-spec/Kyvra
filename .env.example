# Supabase (chave pública/anon, sujeita às políticas RLS do projeto)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Defina ao gerar o APK para conectar ao servidor Kyvra de confiança (HTTPS).
# O servidor deve executar server.ts e manter GEMINI_API_KEY do lado do servidor.
VITE_NATIVE_API_URL=

# Segredos exclusivamente server-side; nunca use o prefixo VITE_.
GEMINI_API_KEY=
GITHUB_TOKEN=
